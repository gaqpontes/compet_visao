{
  "name": "repcounter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "@mediapipe/tasks-vision": "1.1.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "decode-uri-component-fixed": "npm:decode-uri-component@0.5.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-native": "^0.72.8",
    "typescript": "~6.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "@types/jest": "29.5.14"
  },
  "scripts": {
    "start": "node scripts/run-expo.cjs start --offline --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/run-expo.cjs start --web --offline --localhost",
    "lint": "expo lint",
    "test": "jest",
    "prepare:offline": "node scripts/prepare-offline-assets.cjs",
    "serve:local": "node scripts/serve-local.cjs",
    "build:web": "node scripts/run-expo.cjs export --platform web"
  },
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/.native-tools/",
      "<rootDir>/android/",
      "<rootDir>/dist/",
      "<rootDir>/build/",
      "<rootDir>/public/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(decode-uri-component-fixed|.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "file:./vendor/decode-uri-component-compat",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
